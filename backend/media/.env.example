# сервис auth в той же docker-сети
JWKS_URL=http://auth:8000/.well-known/jwks.json
# JWT_ISSUER=
# JWT_AUDIENCE=
DATABASE_URL=postgresql+asyncpg://food_tinder:change_me_strong_password@postgres:5432/food_tinder

# внутренний адрес fileloud (наружу он не опубликован)
FILELOUD_URL=http://fileloud:8000

# лимит на аватар, байт (5 МБ)
AVATAR_MAX_BYTES=5242880
# лимит на фото рецепта, байт (10 МБ)
IMAGE_MAX_BYTES=10485760
# лимит на html гипертекста, байт (1 МБ)
HYPERTEXT_MAX_BYTES=1048576
