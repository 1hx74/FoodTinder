# сервис auth в той же docker-сети (внутри сети он слушает порт 8000, а не 8080)
JWKS_URL=http://auth:8000/.well-known/jwks.json
# JWT_ISSUER=
# JWT_AUDIENCE=
JWT_ALGORITHMS=RS256
DATABASE_URL=postgresql+asyncpg://food_tinder:change_me_strong_password@postgres:5432/food_tinder

# true -> при пустой таблице recipes создаст тестовые рецепты
SEED_DEMO_RECIPES=true