S3_ENDPOINT=http://minio:9000
# должны совпадать с MINIO_ROOT_USER / MINIO_ROOT_PASSWORD сервиса minio в compose.yml
S3_ACCESS_KEY=supersecretadmin
S3_SECRET_KEY=supersecretpassword
S3_BUCKET=my-media-bucket
# внутренний адрес: наружу fileloud не опубликован, ссылки отдаёт сервис media
BASE_URL=http://fileloud:8000
DB_PATH=/data/database.db
