# FoodTinder: SQLite с кодами лежит на docker-томе (см. compose.yml, том email_codes)
DB_PATH=/data/codes.db

HOST=0.0.0.0
PORT=8000

CODE_TTL=300
MAX_VERIFY_ATTEMPTS=5
SEND_COOLDOWN=60

DB_CLEANUP_PERIOD=600

# Gmail, с которого уходят письма, и пароль приложения (НЕ обычный пароль от почты):
# https://myaccount.google.com/apppasswords (нужна включённая двухэтапная аутентификация).
# Если оба пустые — DEV-режим: письмо не отправляется, код печатается в лог
#   docker compose logs email_verificator
GMAIL=
APP_PASSWORD=
